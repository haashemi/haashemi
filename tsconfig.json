{
  "extends": ["@rabits/tsconfig/react"],
  "compilerOptions": {
    "target": "ES2017",
    "plugins": [{ "name": "next" }],

    "paths": {
      "@/components/*": ["./components/*"],
      "@/config/*": ["./config/*"],
      "@/content": ["./.content-collections/generated"],
      "@/lib/*": ["./lib/*"],
      "@/styles/*": ["./styles/*"]
    }
  },
  "include": [
    ".contentlayer/generated",
    ".next/dev/types/**/*.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
