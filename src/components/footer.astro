---
import Icon from "@/components/icon.astro";
import { site } from "@/config/site";
---

<footer class="flex items-center gap-2 border-t py-2 text-center text-xs text-muted-foreground select-none">
  <span class="flex flex-1 justify-end">
    <a href={site.url} class="border-b hover:border-foreground hover:text-foreground"> Ali Hashemi </a>
  </span>
  <span>
    <Icon name="handshake" class="size-3" />
  </span>
  <span class="flex flex-1 justify-start">
    <a href={site.team.url} class="border-b hover:border-foreground hover:text-foreground">
      {site.team.name}
    </a>
  </span>
</footer>
